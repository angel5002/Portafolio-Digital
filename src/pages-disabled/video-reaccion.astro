---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COURSE } from '../lib/portfolio';

// Cuando exista el video: sustituye .video-placeholder por
// <Video youtube="ID" /> o <Video drive="ID" /> (src/components/Video.astro).
const analysis = [
  {
    label: 'Vacíos normativos identificados',
    text: 'Situaciones del dilema que los códigos deontológicos no contemplan adecuadamente. ¿Dónde falló la norma frente a la realidad profesional?'
  },
  {
    label: 'Tensiones ético-legales',
    text: 'Conflictos entre la obligación legal y la conciencia moral del profesional. ¿Cuándo la ley no alcanza para guiar una decisión justa?'
  },
  {
    label: 'Propuesta de humanización',
    text: 'Artículos o reformulaciones propuestas que reflejen una ética más humanista y contextualizada al Perú, fundamentadas filosóficamente.'
  },
  {
    label: 'Reflexión sobre presión de decisión',
    text: 'Cómo influye la presión institucional, social o económica en las decisiones del profesional. Conexión con Weber (ética de la responsabilidad) y Levinas (alteridad).'
  }
];
---

<BaseLayout
  title={`Video-reacción crítico · ${COURSE.portfolioName}`}
  description="Video-reacción crítico al podcast: vacíos éticos, tensiones ético-legales y propuesta de humanización del código deontológico."
  crumbs={[{ label: 'Video-reacción' }]}
>
  <header class="page-header">
    <p class="page-header__eyebrow">Módulo III · Semanas 9–12</p>
    <h1 class="page-header__title">Video-reacción <span class="serif-em">crítico</span></h1>
    <p class="page-header__lead">
      Revisamos nuestro propio podcast con lo aprendido después: qué vacíos éticos
      encontramos y qué artículos del código deontológico deberían humanizarse.
    </p>
  </header>

  <div class="video-layout reveal">
    <div class="video-frame-card">
      <div class="video-placeholder">
        <span class="video-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
        </span>
        <p>Video pendiente · AC7–AC9</p>
      </div>
      <div class="video-meta">
        <p class="video-meta__title">Título del video-reacción</p>
        <p class="video-meta__sub">Se insertará el embed de YouTube, Vimeo o Google Drive · Duración: 8–10 min</p>
      </div>
    </div>

    <div class="analysis-list">
      {analysis.map((a) => (
        <div class="analysis-item">
          <p class="analysis-item__label">{a.label}</p>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
